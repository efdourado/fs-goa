# Copie para .env.local (dev sem Docker) ou use como referência para os
# segredos de produção. Nunca faça commit do arquivo preenchido.

# PostgreSQL. Local sem Docker aponta para o container `postgres` do compose.
DATABASE_URL=postgresql://goa:goa_local_only@127.0.0.1:5433/goa

# Origem pública exata da aplicação (usada na checagem de CSRF/Origin).
APP_ORIGIN=http://localhost:3000

# Conta de administração criada/atualizada por `npm run db:seed`.
# Recebe platform_admin = true (acesso a /admin). Em produção, defina
# ADMIN_PASSWORD como segredo (mínimo 10 caracteres).
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=goa-admin-local

# Limites de criação (opcionais). Baixos por padrão enquanto o app é
# praticamente monousuário; aumente para afrouxar.
MAX_GROUPS_PER_OWNER=6
MAX_CHALLENGES_PER_GROUP=6
